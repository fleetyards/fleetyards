<mj-text mj-class="h2" padding="0 0 14px">
  <%= I18n.t("mailer.hello", username: @resource.username) %>
</mj-text>

<mj-text>
  <%= I18n.t("devise.mailer.password_change.content.text") %>
</mj-text>

<mj-text padding="0 0 4px">
  <%= I18n.t("mailer.security.info") %>
</mj-text>

<%# Only a User has security settings to send them to; an Oauth resource does not. %>
<% if @resource.is_a?(User) %>
  <%= render "shared/mailer/btn",
             href: frontend_security_settings_url,
             label: I18n.t("mailer.security.action"),
             tone: :primary %>
<% end %>
