{
  "name": "fleetyards",
  "private": true,
  "version": "7.2.0",
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "dev:vite": "bin/vite dev --mode=test",
    "dev:playwright:ui": "DEBUG=pw:webserver playwright test --ui",
    "test:e2e:startserver": "RAILS_ENV=test WORKER_COUNT=0 PORT=8280 bundle exec rails s -p 8280 --pid tmp/pids/server_e2e.pid",
    "test:e2e:open": "RAILS_ENV=test concurrently \"pnpm dev:vite\" \"pnpm dev:playwright:ui\" --kill-others",
    "test:e2e:run": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps",
    "lint": "pnpm run lint:js && pnpm run format && pnpm run lint:ts",
    "lint:fix": "pnpm run lint:js:fix && pnpm run format:fix",
    "lint:js": "eslint --ext .js,.ts,.vue app/frontend",
    "lint:js:fix": "eslint --fix --ext .js,.ts,.vue app/frontend",
    "lint:ts": "pnpm run vue-tsc && pnpm run tsc",
    "format": "prettier app/frontend --check",
    "format:fix": "prettier app/frontend --write",
    "vue-tsc": "vue-tsc --noEmit --pretty",
    "tsc": "tsc --noEmit --pretty",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm generate-api-client",
    "generate-api-client": "orval -c orval.config.ts",
    "validate-schema": "npx @redocly/cli@latest lint ./swagger/v1/schema.yaml",
    "validate-admin-schema": "npx @redocly/cli@latest lint ./swagger/admin/v1/schema.yaml",
    "knip": "knip"
  },
  "dependencies": {
    "@appsignal/javascript": "^1.6.1",
    "@appsignal/vue": "^1.1.7",
    "@event-calendar/core": "^5.7.0",
    "@number-flow/vue": "^0.5.2",
    "@rails/actioncable": "8.1.301",
    "@rails/activestorage": "^8.1.301",
    "@tanstack/vue-query": "^5.101.4",
    "@tresjs/cientos": "^5.7.2",
    "@tresjs/core": "^5.8.1",
    "@vee-validate/rules": "^4.15.1",
    "@vuepic/vue-datepicker": "^14.0.0",
    "@vueuse/core": "^14.4.0",
    "ahoy.js": "0.4.5",
    "axios": "1.19.0",
    "clipboard": "2.0.11",
    "core-js": "3.50.0",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dom-to-image": "2.6.0",
    "downloadjs": "1.4.7",
    "foundation-emails": "^2.5.1",
    "highcharts": "13.0.1",
    "highlight.js": "^11.12.0",
    "html2canvas": "1.4.1",
    "i18n-js": "^4.5.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lodash.debounce": "4.0.8",
    "lodash.merge": "^4.6.2",
    "mitt": "^3.0.1",
    "nanoevents": "^10.0.0",
    "panzoom": "9.4.4",
    "papaparse": "5.6.0",
    "photoswipe": "5.4.4",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pnp-webpack-plugin": "1.7.0",
    "prismjs": "^1.30.0",
    "qs": "^6.15.3",
    "sortablejs": "^1.15.7",
    "swagger-ui-dist": "^5.32.14",
    "three": "0.185.1",
    "uuid": "^14.0.2",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.41",
    "vue-collapsed": "^1.3.5",
    "vue-number-animation": "^2.0.2",
    "vue-router": "5.2.0",
    "vue-scrollto": "^2.20.0",
    "vue-upload-component": "^3.2.0",
    "vue3-highlightjs": "^1.0.5",
    "vue3-swatches": "^1.2.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/vue-query-devtools": "^6.1.38",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/ahoy.js": "^0.4.2",
    "@types/downloadjs": "^1.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^26.2.0",
    "@types/qs": "^6.15.1",
    "@types/rails__actioncable": "^8.0.3",
    "@types/rails__activestorage": "^8.0.1",
    "@types/sortablejs": "^1.15.9",
    "@types/swagger-ui": "^5.32.0",
    "@types/swagger-ui-dist": "^3.30.6",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.41",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "2.4.11",
    "c8": "12.0.0",
    "concurrently": "^10.0.5",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.11.0",
    "jsdom": "30.0.1",
    "knip": "^6.32.2",
    "mocha": "11.8.0",
    "msw": "^2.15.0",
    "orval": "^8.25.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "sass": "1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.2.0",
    "stylelint-selector-bem-pattern": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-rails": "0.6.0",
    "vitest": "4.1.11",
    "vue-component-type-helpers": "^3.3.11",
    "vue-tsc": "3.3.11",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "vite-plugin-pwa>vite": "8"
      }
    }
  }
}
