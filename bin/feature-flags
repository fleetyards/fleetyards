#!/usr/bin/env ruby
# frozen_string_literal: true

# `validate` deliberately runs WITHOUT booting Rails, so CI needs neither a
# database nor the bundle. Rails autoloads lib/ via config.autoload_lib, so the
# registry files carry no requires of their own; this script is the one place
# that has to know their load order.

COMMANDS = {
  "validate" => "Validate config/feature_flags.yml against the registry rules (no Rails, no database)",
  "plan" => "Show what `sync` would change, without touching Flipper",
  "sync" => "Reconcile Flipper with config/feature_flags.yml (adds + prunes)",
  "stale" => "List non-permanent flags that have been on for everyone for N days (default 30)",
  "export" => "Print a YAML skeleton of the flags currently in Flipper"
}.freeze

def usage
  puts "Usage: bin/feature-flags <command>"
  puts ""
  puts "Commands:"
  COMMANDS.each { |cmd, desc| puts "  %-10s %s" % [cmd, desc] }
  puts ""
  puts "Arguments:"
  puts "  stale [DAYS]                how many days open before a flag is listed"
  puts ""
  puts "Environment:"
  puts "  FEATURE_FLAGS_PRUNE=false   disable removal for a single `sync` run"
  exit 1
end

def load_registry_classes
  $LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

  require "feature_flags/definition"
  require "feature_flags/registry"
end

def boot_rails
  require_relative "../config/environment"
end

# Only callable once the FeatureFlags constants are loadable — resolving the
# error class in a rescue that also covers the boot itself would mask a boot
# failure with a NameError.
def reporting_registry_errors
  yield
rescue FeatureFlags::Registry::InvalidRegistryError => e
  warn e.message
  exit 1
end

# Read ARGV without consuming it. Booting Rails runs `bundler/setup`, which
# re-execs this process with the *current* ARGV when the activated bundler
# differs from the lockfile's — so a shifted ARGV comes back empty and every
# Rails-booting command falls through to usage.
command = ARGV.first
usage if command.nil? || command == "--help" || command == "-h"

unless COMMANDS.key?(command)
  puts "Unknown command: #{command}"
  usage
end

case command
when "validate"
  load_registry_classes
  reporting_registry_errors do
    registry = FeatureFlags::Registry.load
    puts "✓ config/feature_flags.yml is valid (#{registry.names.size} flags)"
  end

when "plan"
  boot_rails
  reporting_registry_errors { puts FeatureFlags::Synchronizer.new(dry_run: true).call.to_console }

when "sync"
  boot_rails
  reporting_registry_errors { puts FeatureFlags::Synchronizer.new.call.to_console }

when "stale"
  # Parsed before Rails boots, and by hand: reporting_registry_errors only
  # rescues an invalid registry, so `stale abc` would otherwise print a Ruby
  # backtrace where every other command in this script prints a message.
  days = begin
    ARGV[1] ? Integer(ARGV[1]) : FeatureFlags::StaleReport::DEFAULT_THRESHOLD_DAYS
  rescue ArgumentError, TypeError
    warn "DAYS must be a whole number of days, got #{ARGV[1].inspect}"
    exit 1
  end

  boot_rails
  reporting_registry_errors do
    puts FeatureFlags::StaleReport.new(threshold_days: days).to_console
  end

when "export"
  boot_rails
  Flipper.features.map(&:key).sort.each do |name|
    puts <<~YAML
      #{name}:
        description: "TODO"
    YAML
  end
end
