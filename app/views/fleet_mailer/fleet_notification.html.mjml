<mj-text mj-class="h2" padding="0 0 14px">
  <%= I18n.t("mailer.hello", username: @user.username) %>
</mj-text>

<mj-text>
  <%= @notification.title %>
</mj-text>

<%# The body is markdown, the same text the in-app notification renders. %>
<% if @notification.body.present? %>
  <mj-text>
    <%= render_markdown(@notification.body) %>
  </mj-text>
<% end %>

<% if @link.present? %>
  <%= render "shared/mailer/btn",
             href: @link,
             label: I18n.t("mailer.fleet.action"),
             tone: :primary %>
<% end %>
