<mj-text mj-class="h2" padding="0 0 14px">
  <%= I18n.t("mailer.hello", username: @resource.username) %>
</mj-text>

<mj-text padding="0 0 4px">
  <%= I18n.t("devise.mailer.reset_password_instructions.content.first_text") %>
</mj-text>

<%= render "shared/mailer/btn",
           href: frontend_password_reset_url(token: @token),
           label: I18n.t(:"devise.mailer.reset_password_instructions.content.change_link"),
           tone: :primary %>

<%#
  The two caveats after the button - that the link expires, and that ignoring the
  mail leaves the password alone - are the quiet half of this message, so they sit
  in the footer weight rather than competing with the instruction above.
%>
<mj-text mj-class="footer" padding="16px 0 8px">
  <%= I18n.t(:"devise.mailer.reset_password_instructions.content.second_text") %>
</mj-text>

<mj-text mj-class="footer" padding="0 0 4px">
  <%= I18n.t(:"devise.mailer.reset_password_instructions.content.third_text") %>
</mj-text>
