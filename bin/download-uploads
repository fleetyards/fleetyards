#!/usr/bin/env bash

set -u

# Load .env.local if present (worktree config)
if [ -f .env.local ]; then
  set -a
  # shellcheck disable=SC1091
  source .env.local
  set +a
fi

S3_BUCKET="fltyrd-live-storage"
S3_ENDPOINT="fsn1.your-objectstorage.com"

LOCAL_ROOT="./storage"
STAGE_ROOT="./tmp/s3_stage"
# Every object costs a round trip, so throughput comes from concurrency rather
# than bandwidth: batching amortizes s3cmd startup, workers hide the latency.
PARALLEL="${PARALLEL:-8}"
BATCH_SIZE="${BATCH_SIZE:-200}"

DB_PORT="${DB_PORT:-8271}"
DB_NAME="${DB_NAME:-fleetyards_dev${WORKTREE_SUFFIX:-}}"
DB_USER="${DB_USER:-root}"

# Credentials travel through the environment, where s3cmd picks them up on its
# own. Passing them as flags would expose them to any local `ps`.
if [ -z "${AWS_ACCESS_KEY_ID:-}" ]; then
  AWS_ACCESS_KEY_ID=$(op read "op://Fleetyards/HETZNER_S3/access_key_id")
  AWS_SECRET_ACCESS_KEY=$(op read "op://Fleetyards/HETZNER_S3/secret_access_key")
  export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
fi

s3() {
  s3cmd --host="$S3_ENDPOINT" --host-bucket="%(bucket)s.$S3_ENDPOINT" "$@"
}

# The bucket is flat while Active Storage's disk service nests by key prefix.
target_path_for() {
  echo "$LOCAL_ROOT/${1:0:2}/${1:2:2}/$1"
}

human_size() {
  awk -v bytes="$1" 'BEGIN {
    split("B KB MB GB TB", units, " ")
    i = 1
    while (bytes >= 1024 && i < 5) { bytes /= 1024; i++ }
    printf (i == 1 ? "%d %s" : "%.1f %s"), bytes, units[i]
  }'
}

# Worker mode: fetch one batch of keys, then file them into the disk layout.
# Re-invoked through xargs, one process per batch. Prints each stored key so the
# parent can count progress.
if [ "${1:-}" = "--fetch-batch" ]; then
  shift

  mkdir -p "$STAGE_ROOT"
  stage=$(mktemp -d "$STAGE_ROOT/batch.XXXXXX") || exit 1
  s3cmd_log=$(mktemp)
  trap 'rm -rf "$stage" "$s3cmd_log"' EXIT

  sources=()
  for key in "$@"; do
    sources+=("s3://$S3_BUCKET/$key")
  done

  # Kept rather than discarded: without it a failed batch reports only which
  # keys are missing, not why (throttling, auth, a vanished object).
  s3 get --force --quiet "${sources[@]}" "$stage/" > "$s3cmd_log" 2>&1

  status=0
  for key in "$@"; do
    if [ ! -f "$stage/$key" ]; then
      echo "WARN: failed to download $key" >&2
      status=1
      continue
    fi

    target=$(target_path_for "$key")
    mkdir -p "$(dirname "$target")"

    if mv -f "$stage/$key" "$target"; then
      echo "$key"
    else
      echo "WARN: could not store $key" >&2
      status=1
    fi
  done

  if [ "$status" != "0" ]; then
    reason=$(grep -aE "^(ERROR|WARNING)" "$s3cmd_log" | sort -u | head -3)
    [ -n "$reason" ] || reason=$(tail -3 "$s3cmd_log")
    [ -n "$reason" ] && printf 'WARN: s3cmd reported for this batch:\n%s\n' "$reason" >&2
  fi

  exit $status
fi

mkdir -p "$LOCAL_ROOT" "$STAGE_ROOT"

REMOTE_LIST=$(mktemp)
PENDING=$(mktemp)
REMOTE_KEYS=$(mktemp)
LOCAL_KEYS=$(mktemp)
DB_KEYS=$(mktemp)
trap 'rm -f "$REMOTE_LIST" "$PENDING" "$REMOTE_KEYS" "$LOCAL_KEYS" "$DB_KEYS"' EXIT
trap 'echo ""; echo "Interrupted — re-run to resume where this left off."; exit 130' INT

echo "Listing s3://$S3_BUCKET..."
s3 ls "s3://$S3_BUCKET/" | awk -v bucket="$S3_BUCKET" '
  $1 != "DIR" && $4 ~ "^s3://" bucket "/" {
    key = substr($4, length("s3://" bucket "/") + 1)
    if (key != "") print $3 "\t" key
  }
' > "$REMOTE_LIST"
list_status=${PIPESTATUS[0]}

# A listing cut short by a failed request would read as most of storage/ having
# left the bucket, and the cleanup below would delete it.
if [ "$list_status" != "0" ]; then
  echo "ERROR: listing s3://$S3_BUCKET/ failed (s3cmd exited $list_status)"
  exit 1
fi

remote_count=$(wc -l < "$REMOTE_LIST" | tr -d ' ')
if [ "$remote_count" = "0" ]; then
  echo "ERROR: could not list any objects in s3://$S3_BUCKET/"
  exit 1
fi

echo "Checking which of the $remote_count objects are already present..."

pending_bytes=0
present=0

while IFS=$'\t' read -r size key; do
  target=$(target_path_for "$key")

  if [ -f "$target" ] && [ "$(stat -f%z "$target")" = "$size" ]; then
    present=$((present + 1))
    continue
  fi

  printf '%s\n' "$key" >> "$PENDING"
  pending_bytes=$((pending_bytes + size))
done < "$REMOTE_LIST"

pending_count=$(wc -l < "$PENDING" | tr -d ' ')

# The mirror only ever adds, so objects deleted from the bucket stay on disk
# until removed here. A key the local database still references is kept even
# when the bucket has dropped it: local sc_data loads and uploads write blobs
# that never reach the bucket.
remove_deleted_objects() {
  if ! PGPASSWORD=password psql -qtAX -h localhost -U "$DB_USER" -p "$DB_PORT" -d "$DB_NAME" \
    -c "SELECT key FROM active_storage_blobs" > "$DB_KEYS" 2> /dev/null; then
    echo "  Skipping cleanup: could not read blob keys from $DB_NAME on localhost:$DB_PORT."
    return
  fi

  sort -o "$DB_KEYS" "$DB_KEYS"

  cut -f2 "$REMOTE_LIST" | sort > "$REMOTE_KEYS"
  find "$LOCAL_ROOT" -type f ! -name '.*' | awk -F/ '{ print $NF }' | sort > "$LOCAL_KEYS"

  local removed=0
  local removed_bytes=0
  local key target size

  while read -r key; do
    target=$(target_path_for "$key")
    size=$(stat -f%z "$target" 2> /dev/null || echo 0)

    if rm -f "$target"; then
      removed=$((removed + 1))
      removed_bytes=$((removed_bytes + size))
    fi
  done < <(comm -23 "$LOCAL_KEYS" "$REMOTE_KEYS" | comm -23 - "$DB_KEYS")

  find "$LOCAL_ROOT" -mindepth 1 -type d -empty -delete

  echo "  Removed:         $removed deleted from the bucket ($(human_size "$removed_bytes"))"
}

remove_deleted_objects

echo "  Already present: $present"
echo "  To download:     $pending_count ($(human_size "$pending_bytes"))"

if [ "$pending_count" = "0" ]; then
  rm -rf "$STAGE_ROOT"
  echo ""
  echo "Uploads are up to date."
  exit 0
fi

echo ""
echo "Downloading in batches of $BATCH_SIZE across $PARALLEL workers..."

xargs -n "$BATCH_SIZE" -P "$PARALLEL" "$0" --fetch-batch < "$PENDING" |
  awk -v total="$pending_count" '
    { stored++; if (stored % 50 == 0) { printf "\r  Stored %d/%d objects...", stored, total; fflush() } }
    END { printf "\r  Stored %d/%d objects.   \n", stored, total }
  '
fetch_status=${PIPESTATUS[0]}

rm -rf "$STAGE_ROOT"

echo ""
if [ "$fetch_status" != "0" ]; then
  echo "Some objects could not be downloaded — re-run to retry just those."
  exit 1
fi

echo "Done! Uploads are in sync."
