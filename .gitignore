.bundle
.worktrees

# logfiles and tempfiles.
log/*
tmp/*
# not dumps/* — in worktrees this is a symlink to the main worktree, and a
# contents pattern would leave the link itself untracked.
dumps

pids/*

# config files
config/credentials/*.key
config/*.key
.env*
!.env.tpl

# test files
coverage/*
test/reports/*
playwright-report
playwright-report/*
test-results
test-results/*

# generated auto-import files
app/frontend/auto-imports.d.ts
app/frontend/components.d.ts
.eslintrc-auto-import.json

# generated api client
app/frontend/services/fyApi
app/frontend/services/fyOAuthApi
app/frontend/services/fyAdminApi

# generated cable client
app/frontend/services/fyCable
app/frontend/services/fyCableAdmin

# app files
public/uploads/*
public/assets
public/compare/*
public/vite*

# active storage uploads
storage

# js dependencies
vendor/assets/.bowerrc
vendor/assets/bower.json
vendor/assets/bower_components/jquery
vendor/assets/bower_components/bootstrap
vendor/assets/bower_components/sweetalert

.byebug_history

node_modules
yarn-error.log
yarn-debug.log*
.yarn-integrity
build

.eslintcache

blocklist.json
reserved_usernames.json

REVISION

# tmp disable spec todos
swagger/todo

/app/assets/builds/*
!/app/assets/builds/.keep

# Build input for the loader jobs, not application data -- fetched from object
# storage with `bin/scdata sync` / `bin/scdata pull`.
data/sc_data/raw
data/sc_data/parsed

# ai agent files
.cursor/working/
.augment/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# superset (ports.json is generated by bin/setup)
.superset/ports.json
