#!/usr/bin/env ruby
# frozen_string_literal: true

# Reporting only. Copying the artwork is Maintenance::CopyPaintStoreImagesTask,
# so the write that has to run against production does so where it can be
# watched, throttled and resumed, rather than from somebody's shell.

COMMANDS = {
  "match-report" => "Report which paint Components match a ModelPaint, writing nothing"
}.freeze

def usage
  puts "Usage: bin/paints <command>"
  puts ""
  puts "Commands:"
  COMMANDS.each { |cmd, desc| puts "  %-16s %s" % [cmd, desc] }
  exit 1
end

command = ARGV.shift
usage if command.nil? || command == "--help" || command == "-h"

unless COMMANDS.key?(command)
  puts "Unknown command: #{command}"
  usage
end

require_relative "../config/environment"

components = Component.where(category: "paints").where.not(name: [nil, ""]).order(:name)
matcher = PaintComponentMatcher.new

case command
when "match-report"
  matched, unmatched = components.partition { |component| matcher.call(component) }

  puts "paint components: #{components.count}"
  puts "matched:          #{matched.size}"
  puts "unmatched:        #{unmatched.size}"

  puts ""
  puts "Unmatched:"
  unmatched.each { |component| puts "  #{component.name}" }
end
