<mj-text mj-class="h2" padding="0 0 14px">
  <%= I18n.t("mailer.plain_hello") %>
</mj-text>

<mj-text>
  <%= I18n.t("mailer.fleet_membership.member_accepted.headline", username: @member_username, fleet: @fleet.name) %>
</mj-text>

<mj-text padding="0 0 4px">
  <%= I18n.t("mailer.fleet_membership.member_accepted.body") %>
</mj-text>

<%= render "shared/mailer/btn",
           href: frontend_fleet_members_url(slug: @fleet.slug),
           label: I18n.t("mailer.fleet_membership.member_accepted.action", fleet: @fleet.name),
           tone: :primary %>
