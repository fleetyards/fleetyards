#!/usr/bin/env ruby
# frozen_string_literal: true

# Validates config/feature_flags.yml against the registry rules WITHOUT booting
# Rails, so CI needs neither a database nor the bundle. `rake feature_flags:validate`
# is the equivalent for local use.
#
# Rails autoloads lib/ via config.autoload_lib, so the registry files carry no
# requires of their own; this script is the one place that has to know their load
# order.

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "feature_flags/definition"
require "feature_flags/registry"

begin
  registry = FeatureFlags::Registry.load
  puts "✓ config/feature_flags.yml is valid (#{registry.names.size} flags)"
rescue FeatureFlags::Registry::InvalidRegistryError => e
  warn e.message
  exit 1
end
