#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require_relative "../lib/cli_helpers"

EXPORT_FOLDER = "data/sc_data"

COMMANDS = {
  "sync" => "Sync a raw SC data export from S3 (optionally specify an environment or version)",
  "parse" => "Parse SC data for the given environment",
  "check" => "Check the parsed tree for the given environment before it is pushed",
  "push" => "Upload the parsed tree for the given environment to S3",
  "pull" => "Download the parsed tree for the given environment from S3",
  "manifest" => "Rewrite the parsed tree's version.json from the files on disk, without re-parsing",
  "cache-key" => "Print the CI cache key for every configured source, from the trees in S3",
  "load" => "Load all SC data for the given environment (manufacturers, items, models, modules)",
  "load:manufacturers" => "Load manufacturers for the given environment",
  "load:items" => "Load items for the given environment",
  "load:models" => "Load models (hardpoints) for the given environment",
  "load:modules" => "Load model modules for the given environment"
}.freeze

# What each load command runs, and what to call it while it runs. Bodies are not
# evaluated until the step is reached, so naming the loaders here does not need
# Rails to be booted yet.
LOAD_STEPS = {
  "load" => ["all SC Data", -> { ScData::Loader::BaseLoader.all }],
  "load:manufacturers" => ["manufacturers", -> { ScData::Loader::ManufacturersLoader.new.all }],
  "load:items" => ["items", -> { ScData::Loader::ItemsLoader.new.all }],
  "load:models" => ["models", -> { ScData::Loader::ModelsLoader.new.all }],
  "load:modules" => ["model modules", -> { ScData::Loader::ModelModulesLoader.new.all }]
}.freeze

def usage
  puts "Usage: bin/scdata <command> [args]"
  puts ""
  puts "Commands:"
  COMMANDS.each { |cmd, desc| puts "  %-20s %s" % [cmd, desc] }
  exit 1
end

def boot_rails
  require_relative "../config/environment"
end

# The build a load is about to write. Naming an environment loads that one
# without moving the default onto it -- `ScData::Source.with` is the same seam a
# request goes through, so a loader resolves its build the way it always does
# rather than reading the config a second way.
def requested_source(environment)
  return ScData::Source.current if environment.blank?

  source = ScData::Source.find(environment)

  abort "No build configured for environment: #{environment}" if source.blank?

  source
end

# Under `bin/op` the settings are already in the environment, resolved from
# `.env.tpl` -- which is also how production supplies them to the loader jobs.
# Run bare, this falls back to reading 1Password directly, so neither
# invocation needs the wrapper.
def s3_settings(optional: false)
  return ScData::ObjectStore.settings if ScData::ObjectStore.configured?

  {
    endpoint: "https://fsn1.your-objectstorage.com",
    bucket: "fltyrd-sc",
    access_key_id: read_secret("access_key_id", optional: optional),
    secret_access_key: read_secret("secret_access_key", optional: optional)
  }
end

# `optional` is for the one caller that has somewhere to go without the
# credentials. A CI run that cannot reach 1Password -- a Dependabot or fork pull
# request, which reads secrets from a store it has no access to -- still needs a
# cache key, and `ScData::CacheKey` answers with the version. Returning nil lets
# `ObjectStore` raise `NotConfigured`, which is what that fallback rescues.
# Every other caller moves data and has nothing to fall back on.
def read_secret(field, optional: false)
  value = `op read "op://Fleetyards/HETZNER_S3/#{field}"`.strip

  unless $?.success?
    return nil if optional

    abort "Could not read #{field} from 1Password. Unlock it and retry."
  end

  value
end

# Prints what the check found and answers whether the tree is fit to push.
# A step's block cannot fail the step -- `CliHelpers.execute_step` discards what
# it returns -- so the verdict is printed here and the caller decides, the same
# way `sync` handles an environment with no export.
def report_check(sc_environment)
  result = nil

  CliHelpers.run_step("Checking the parsed tree (#{sc_environment})") do
    result = ScData::ParsedCheck.new(sc_environment).call
    [true, ""]
  end

  result.stats.each do |folder, stats|
    icons = stats[:icons_named].positive? ? ", #{stats[:icons_named] - stats[:icons_absent]}/#{stats[:icons_named]} icons resolve" : ""

    puts "  %-14s %6d files%s" % [folder, stats[:files], icons]
  end

  if result.ok?
    puts "  Nothing to report."
    return true
  end

  puts "  #{result.problems.size} problem(s):"
  result.problems.first(20).each { |problem| puts "    #{problem}" }

  remaining = result.problems.size - 20
  puts "    ... and #{remaining} more" if remaining.positive?

  false
end

def latest_version(export_folder, sc_environment)
  raw_path = File.join(export_folder, "raw")
  abort "Raw data folder not found: #{raw_path}" unless Dir.exist?(raw_path)

  folders = Dir.children(raw_path)
    .select { |name| name.match?(/\A.+-#{Regexp.escape(sc_environment)}\.\d+\z/) }
    .sort_by { |name| name.match(/\.(\d+)\z/)[1].to_i }

  abort "No data found for environment: #{sc_environment}" if folders.empty?

  folders.last
end

# Shift a copy, never ARGV itself — see the note in bin/feature-flags: booting
# Rails can re-exec this process with the current ARGV, so a consumed ARGV
# comes back short and the positional args land in the wrong slots.
args = ARGV.dup
# Consumed before the command, so it can be written on either side of it.
# `present?` is not available yet: ActiveSupport arrives with the Rails boot.
force = !args.delete("--force").nil?
command = args.shift
usage if command.nil? || command == "--help" || command == "-h"

case command
when "sync"
  CliHelpers.run_step("Booting Rails") {
    boot_rails
    [true, ""]
  }

  # Either an export folder or the environment to take the newest one from, so
  # `sync ptu` reads the way `parse ptu` does. Bare, it follows the configured
  # default rather than whatever build happens to be newest in the bucket --
  # picking that up would sync a ptu export to someone who only ever asked
  # about live.
  target = args.shift || ScData::Source.environment
  version = target

  unless ScData::RawStore::VERSION_PATTERN.match?(target)
    CliHelpers.run_step("Finding the newest #{target} export") do
      version = ScData::RawStore.latest(target, settings: s3_settings)
      [version.present?, version.present? ? "" : "no export found for environment: #{target}"]
    end
    abort if version.blank?

    puts "  Newest #{target} export: #{version}"
  end

  store = ScData::RawStore.new(version, settings: s3_settings)
  result = nil

  CliHelpers.run_step("Syncing #{version} to #{store.local_root.relative_path_from(Rails.root)}") do
    result = store.pull
    [true, ""]
  end

  puts "  Downloaded: #{result[:downloaded]}, unchanged: #{result[:unchanged]}"

when "parse"
  CliHelpers.run_step("Booting Rails") {
    boot_rails
    [true, ""]
  }

  sc_environment = args.shift || ScData::Source.environment
  sc_version = latest_version(EXPORT_FOLDER, sc_environment)

  CliHelpers.run_step("Parsing SC Data #{sc_version} (#{sc_environment})") do
    ScData::Parser::BaseParser.all(base_folder: Rails.root.join(EXPORT_FOLDER), sc_version:, sc_environment:)
    [true, ""]
  end

  # Rewrites this environment's entry and leaves the others alone: parsing ptu
  # must not drop the version live is on, or every reader of live would follow
  # the wrong build.
  config_path = File.join(Dir.pwd, "config/app/sc_data.yml")
  config = YAML.safe_load_file(config_path).fetch("shared", {})
  sources = config.fetch("sources", {}).merge(sc_environment => sc_version)
  default = config["default"] || sources.keys.first

  # Built line by line rather than interpolated into a squiggly heredoc: that
  # strips the indentation off the first interpolated line and leaves it on the
  # rest, which is invalid YAML and only shows up on the next boot.
  lines = [
    "shared:",
    "  # The build each environment is on. `bin/scdata parse <environment>`",
    "  # rewrites its own entry and leaves the others alone, so live and ptu can",
    "  # be parsed independently.",
    "  sources:"
  ]
  sources.each { |environment, version| lines << %(    #{environment}: "#{version}") }
  lines += ["", "  # What a request that does not name a source gets.", "  default: #{default}"]

  File.write(config_path, "#{lines.join("\n")}\n")

  puts "  Updated config/app/sc_data.yml: #{sc_environment} -> #{sc_version}"

  # The parsed tree is not in git, so the commodity keys a test asserts against
  # are committed here instead. Rewritten on every parse so they cannot drift
  # from what the parser actually produced.
  require "json"

  keys = Dir.glob(File.join(Dir.pwd, "data/sc_data/parsed", sc_environment, "commodities/*.json"))
    .map { |file| JSON.parse(File.read(file))["sc_key"] }
    .compact
    .sort

  if keys.any?
    keys_dir = File.join(Dir.pwd, "test/fixtures/sc_data", sc_environment)
    FileUtils.mkdir_p(keys_dir)
    File.write(File.join(keys_dir, "commodity_keys.json"), "#{JSON.pretty_generate(keys)}\n")

    puts "  Updated test/fixtures/sc_data/#{sc_environment}/commodity_keys.json (#{keys.size} keys)"
  end

  # Reported rather than enforced: the tree is written by the time anyone can
  # read this, and what a parse produced is worth seeing whether or not it is
  # fit to push. `push` is where it decides anything.
  report_check(sc_environment)

when "check"
  CliHelpers.run_step("Booting Rails") {
    boot_rails
    [true, ""]
  }

  sc_environment = args.shift || ScData::Source.environment

  abort unless report_check(sc_environment)

# Recomputes the checksum from the tree already on disk. A tree pushed before
# the parser started writing one has no checksum at all, and re-parsing the build
# just to obtain it would drag in every parser change since -- which for a stale
# environment is a far bigger diff than the one file that actually needs to move.
when "manifest"
  CliHelpers.run_step("Booting Rails") {
    boot_rails
    [true, ""]
  }

  sc_environment = args.shift || ScData::Source.environment
  source = requested_source(sc_environment)

  manifest_path = Rails.root.join(EXPORT_FOLDER, "parsed", source.environment, ScData::ParsedTree::MANIFEST)

  # Restamping a tree with a build it was not parsed from is the failure
  # `ParsedCheck` exists to catch: the pointer and the payload disagree, and a
  # load then stamps rows of one build with the version of another. Re-parsing
  # is the fix for that, not relabelling.
  if manifest_path.file?
    stated = begin
      JSON.parse(manifest_path.read)
    rescue
      {}
    end

    if stated["version"].present? && stated["version"] != source.version
      abort "  The tree on disk was parsed from #{stated["version"]}, not #{source.version}. Re-parse it, or point the config at the build it holds."
    end

    if stated["environment"].present? && stated["environment"] != source.environment
      abort "  The tree on disk is #{stated["environment"]}, not #{source.environment}."
    end
  end

  CliHelpers.run_step("Writing the manifest for #{source}") do
    ScData::Parser::BaseParser.write_manifest(
      base_folder: Rails.root.join(EXPORT_FOLDER),
      sc_version: source.version,
      sc_environment: source.environment
    )
    [true, ""]
  end

  manifest = JSON.parse(manifest_path.read)
  puts "  version:  #{manifest["version"]}"
  puts "  checksum: #{manifest["checksum"]}"

# What CI keys its parsed-tree cache on. The tree's own checksum rather than the
# build version: a parser change rewrites the tree and leaves the version where
# it was, which is why this used to need a hand-bumped `vN` prefix.
#
# Never fails. The step this replaces was a local YAML read that could not, and
# it gates every `ruby-tests` run -- including ones whose cache would have hit
# and needed no network at all. A bucket that cannot be reached falls back to
# the version, which is what the key held before any of this, so a Hetzner blip
# costs a stale cache entry rather than a red run on every open PR.
when "cache-key"
  boot_rails

  result = ScData::CacheKey.call(settings: s3_settings(optional: true))

  result.warnings.each { |warning| warn "  #{warning}" }

  # A bare `key=` would collapse every run onto one cache entry whatever the
  # trees are, which is worse than no cache at all.
  abort "  No source carries a version; nothing to key on." if result.empty?

  puts "key=#{result.key}"
  puts "default=#{ScData::Source.environment}"

when "push", "pull"
  CliHelpers.run_step("Booting Rails") {
    boot_rails
    [true, ""]
  }

  sc_environment = args.shift || ScData::Source.environment

  # Pushing is what makes a tree real: it replaces the one the loaders pull, and
  # a tree the check has something to say about is exactly the one nobody wants
  # in the bucket. `--force` is here because a floor is a guess about a future
  # build, and a person who has read the list has to be able to overrule it --
  # so it overrules the verdict and never the check itself, which still runs and
  # still prints, and says so when it was overruled.
  if command == "push" && !report_check(sc_environment)
    abort "  Refusing to push. Fix the tree, or push it anyway with --force." unless force

    puts "  Pushing anyway: --force."
  end

  store = ScData::ParsedStore.new(sc_environment, settings: s3_settings)
  result = nil

  CliHelpers.run_step("#{command.capitalize}ing parsed tree (#{sc_environment})") do
    result = store.public_send(command)
    [true, ""]
  end

  moved = result[:uploaded] || result[:downloaded]
  puts "  #{(command == "push") ? "Uploaded" : "Downloaded"}: #{moved}, removed: #{result[:removed]}, unchanged: #{result[:unchanged]}"

when *LOAD_STEPS.keys
  CliHelpers.run_step("Booting Rails") {
    boot_rails
    [true, ""]
  }

  source = requested_source(args.shift)
  label, load = LOAD_STEPS.fetch(command)

  CliHelpers.run_step("Loading #{label} (#{source})") do
    ScData::Source.with(source) { load.call }
    [true, ""]
  end

else
  puts "Unknown command: #{command}"
  usage
end
