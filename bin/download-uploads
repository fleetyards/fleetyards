#!/usr/bin/env bash

set -u

# Development fetches missing uploads on demand, so a full download is only
# needed to work offline.
#
#   bin/download-uploads                    fetch every upload
#   bin/download-uploads --trim             delete local copies of what the bucket holds
#   bin/download-uploads --trim --dry-run   only report what --trim would delete

TRIM=0
DRY_RUN=0

for arg in "$@"; do
  case "$arg" in
    --trim) TRIM=1 ;;
    --dry-run) DRY_RUN=1 ;;
    *)
      echo "ERROR: unknown option $arg"
      exit 1
      ;;
  esac
done

if [ "$DRY_RUN" = "1" ] && [ "$TRIM" = "0" ]; then
  echo "ERROR: --dry-run only works with --trim"
  exit 1
fi

# Load .env.local if present (worktree config)
if [ -f .env.local ]; then
  set -a
  # shellcheck disable=SC1091
  source .env.local
  set +a
fi

S3_BUCKET="fltyrd-live-uploads"
S3_ENDPOINT="de-s3.storage.bunnycdn.com"

LOCAL_ROOT="./storage"
STAGE_ROOT="./tmp/s3_stage"
# Every object costs a round trip, so throughput comes from concurrency rather
# than bandwidth.
TRANSFERS="${TRANSFERS:-16}"

DB_PORT="${DB_PORT:-8271}"
DB_NAME="${DB_NAME:-fleetyards_dev${WORKTREE_SUFFIX:-}}"
DB_USER="${DB_USER:-root}"

if ! command -v rclone > /dev/null; then
  echo "ERROR: rclone is not installed (brew install rclone)."
  exit 1
fi

# Credentials travel through the environment, where rclone picks them up on its
# own. Passing them as flags would expose them to any local `ps`.
if [ -z "${AWS_ACCESS_KEY_ID:-}" ]; then
  AWS_ACCESS_KEY_ID=$(op read "op://Fleetyards/BUNNY_UPLOADS_LIVE/config/zone_name")
  AWS_SECRET_ACCESS_KEY=$(op read "op://Fleetyards/BUNNY_UPLOADS_LIVE/password")
  export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
fi

export RCLONE_CONFIG=""
export RCLONE_CONFIG_UPLOADS_TYPE=s3
export RCLONE_CONFIG_UPLOADS_PROVIDER=Other
export RCLONE_CONFIG_UPLOADS_ENV_AUTH=true
export RCLONE_CONFIG_UPLOADS_ENDPOINT="https://$S3_ENDPOINT"
export RCLONE_CONFIG_UPLOADS_REGION=de
REMOTE="uploads:$S3_BUCKET"

# The bucket is flat while Active Storage's disk service nests by key prefix.
target_path_for() {
  echo "$LOCAL_ROOT/${1:0:2}/${1:2:2}/$1"
}

human_size() {
  awk -v bytes="$1" 'BEGIN {
    split("B KB MB GB TB", units, " ")
    i = 1
    while (bytes >= 1024 && i < 5) { bytes /= 1024; i++ }
    printf (i == 1 ? "%d %s" : "%.1f %s"), bytes, units[i]
  }'
}

mkdir -p "$LOCAL_ROOT" "$STAGE_ROOT"

REMOTE_LIST=$(mktemp)
PENDING=$(mktemp)
REMOTE_KEYS=$(mktemp)
LOCAL_KEYS=$(mktemp)
DB_KEYS=$(mktemp)
trap 'rm -f "$REMOTE_LIST" "$PENDING" "$REMOTE_KEYS" "$LOCAL_KEYS" "$DB_KEYS"' EXIT
trap 'echo ""; echo "Interrupted — re-run to resume where this left off."; exit 130' INT

echo "Listing s3://$S3_BUCKET..."
# Top level only: blobs sit at the root, overlay exports in folders.
rclone lsf "$REMOTE" --files-only --format sp --separator $'\t' > "$REMOTE_LIST"
list_status=$?

# A listing cut short by a failed request would read as most of storage/ having
# left the bucket, and the cleanup below would delete it.
if [ "$list_status" != "0" ]; then
  echo "ERROR: listing s3://$S3_BUCKET/ failed (rclone exited $list_status)"
  exit 1
fi

remote_count=$(wc -l < "$REMOTE_LIST" | tr -d ' ')
if [ "$remote_count" = "0" ]; then
  echo "ERROR: could not list any objects in s3://$S3_BUCKET/"
  exit 1
fi

# Only a file whose key and size the bucket confirms can be fetched again;
# everything else may exist nowhere but here.
trim_uploads() {
  local removed=0
  local removed_bytes=0
  local size path

  while IFS=$'\t' read -r size path; do
    if [ "$DRY_RUN" = "0" ]; then
      rm "$path" || continue
    fi

    removed=$((removed + 1))
    removed_bytes=$((removed_bytes + size))
  done < <(
    find -H "$LOCAL_ROOT" -mindepth 3 -maxdepth 3 -type f ! -name '.*' -exec stat -f '%z%t%N' {} + |
      awk -F'\t' '
        NR == FNR { remote[$2] = $1; next }
        {
          n = split($2, parts, "/")
          key = parts[n]
          if (parts[n - 2] == substr(key, 1, 2) && parts[n - 1] == substr(key, 3, 2) && (key in remote) && remote[key] == $1) print
        }
      ' "$REMOTE_LIST" -
  )

  if [ "$DRY_RUN" = "1" ]; then
    echo "  Would remove: $removed files ($(human_size "$removed_bytes"))"
    return
  fi

  find -H "$LOCAL_ROOT" -mindepth 1 -type d -empty -delete
  echo "  Removed: $removed files ($(human_size "$removed_bytes"))"
}

if [ "$TRIM" = "1" ]; then
  trim_uploads
  exit 0
fi

echo "Checking which of the $remote_count objects are already present..."

pending_bytes=0
present=0

while IFS=$'\t' read -r size key; do
  target=$(target_path_for "$key")

  if [ -f "$target" ] && [ "$(stat -f%z "$target")" = "$size" ]; then
    present=$((present + 1))
    continue
  fi

  printf '%s\n' "$key" >> "$PENDING"
  pending_bytes=$((pending_bytes + size))
done < "$REMOTE_LIST"

pending_count=$(wc -l < "$PENDING" | tr -d ' ')

# The mirror only ever adds, so objects deleted from the bucket stay on disk
# until removed here. A key some local database still references is kept even
# when the bucket has dropped it: local sc_data loads and uploads write blobs
# that never reach the bucket. bin/setup links storage/ into every worktree, so
# that means every worktree's database, not just this checkout's.
read_local_blob_keys() {
  local databases database

  databases=$(PGPASSWORD=password psql -qtAX -h localhost -U "$DB_USER" -p "$DB_PORT" -d postgres \
    -c "SELECT datname FROM pg_database WHERE datname LIKE 'fleetyards_dev%' OR datname = '$DB_NAME'" 2> /dev/null) || return 1

  [ -n "$databases" ] || return 1

  for database in $databases; do
    PGPASSWORD=password psql -qtAX -h localhost -U "$DB_USER" -p "$DB_PORT" -d "$database" \
      -c "SELECT key FROM active_storage_blobs" 2> /dev/null || return 1
  done
}

remove_deleted_objects() {
  if ! read_local_blob_keys > "$DB_KEYS"; then
    echo "  Skipping cleanup: could not read blob keys from every database on localhost:$DB_PORT."
    return
  fi

  # An unrestored database answers with no keys, which would leave nothing kept.
  if [ ! -s "$DB_KEYS" ]; then
    echo "  Skipping cleanup: no local database references any blob."
    return
  fi

  sort -u -o "$DB_KEYS" "$DB_KEYS"
  cut -f2 "$REMOTE_LIST" | sort > "$REMOTE_KEYS"

  # -H follows storage/ itself, which is a symlink in a worktree. Only files at
  # the path Active Storage would give their key are candidates, so a stray file
  # is never mistaken for an object.
  find -H "$LOCAL_ROOT" -mindepth 3 -maxdepth 3 -type f ! -name '.*' |
    awk -F/ '$(NF-2) == substr($NF, 1, 2) && $(NF-1) == substr($NF, 3, 2) { print $NF "\t" $0 }' |
    sort -t$'\t' -k1,1 > "$LOCAL_KEYS"

  local removed=0
  local removed_bytes=0
  local key path size

  while IFS=$'\t' read -r key path; do
    size=$(stat -f%z "$path") || continue

    if rm "$path"; then
      removed=$((removed + 1))
      removed_bytes=$((removed_bytes + size))
    fi
  done < <(cut -f1 "$LOCAL_KEYS" | comm -23 - "$REMOTE_KEYS" | comm -23 - "$DB_KEYS" | join -t$'\t' - "$LOCAL_KEYS")

  find -H "$LOCAL_ROOT" -mindepth 1 -type d -empty -delete

  echo "  Removed:         $removed deleted from the bucket ($(human_size "$removed_bytes"))"
}

remove_deleted_objects

echo "  Already present: $present"
echo "  To download:     $pending_count ($(human_size "$pending_bytes"))"

if [ "$pending_count" = "0" ]; then
  rm -rf "$STAGE_ROOT"
  echo ""
  echo "Uploads are up to date."
  exit 0
fi

echo ""
echo "Downloading with $TRANSFERS parallel transfers..."

# One process keeps its connections open. A process per batch opened a new one
# for every object and ran the Mac out of local ports. Files land flat in the
# stage first; one left there by an interrupted run is not fetched again.
rclone copy "$REMOTE" "$STAGE_ROOT" --files-from-raw "$PENDING" --no-traverse \
  --transfers "$TRANSFERS" --checkers "$TRANSFERS" --retries 3 \
  --stats 10s --stats-one-line --stats-log-level NOTICE
fetch_status=$?

stored=0
missing=0

while IFS= read -r key; do
  if [ ! -f "$STAGE_ROOT/$key" ]; then
    missing=$((missing + 1))
    [ "$missing" -le 10 ] && echo "WARN: failed to download $key" >&2
    continue
  fi

  target=$(target_path_for "$key")
  mkdir -p "$(dirname "$target")"
  mv -f "$STAGE_ROOT/$key" "$target" && stored=$((stored + 1))
done < "$PENDING"

echo "  Stored $stored/$pending_count objects."

echo ""
if [ "$missing" != "0" ] || [ "$fetch_status" != "0" ]; then
  echo "$missing objects could not be downloaded (rclone exited $fetch_status) — re-run to retry just those."
  exit 1
fi

rm -rf "$STAGE_ROOT"

echo "Done! Uploads are in sync."
