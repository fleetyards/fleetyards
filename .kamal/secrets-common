# All secrets are fetched from 1Password (vault: Fleetyards)
# Requires OP_SERVICE_ACCOUNT_TOKEN to be set in the environment

VAULT="Fleetyards"

# Shared secrets
S3_ACCESS_KEY_ID=$(op read "op://$VAULT/HETZNER_S3/access_key_id")
S3_SECRET_ACCESS_KEY=$(op read "op://$VAULT/HETZNER_S3/secret_access_key")
APPSIGNAL_PUSH_API_KEY=$(op read "op://$VAULT/APPSIGNAL/credential")

# sc_data store, read only: nothing on the servers writes to it
SC_DATA_S3__ENDPOINT=$(op read "op://$VAULT/R2_SC_DATA_READ/config/endpoint")
SC_DATA_S3__ACCESS_KEY_ID=$(op read "op://$VAULT/R2_SC_DATA_READ/username")
SC_DATA_S3__SECRET_ACCESS_KEY=$(op read "op://$VAULT/R2_SC_DATA_READ/password")

# uploads-copy accessory, Hetzner side
RCLONE_CONFIG_HETZNER_ACCESS_KEY_ID=$S3_ACCESS_KEY_ID
RCLONE_CONFIG_HETZNER_SECRET_ACCESS_KEY=$S3_SECRET_ACCESS_KEY
